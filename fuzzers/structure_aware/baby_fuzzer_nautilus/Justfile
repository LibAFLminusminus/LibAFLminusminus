import "../../../just/libafl.just"
FUZZER_NAME := "baby_fuzzer_nautilus"

build:
    cargo build --locked --profile {{ PROFILE }}

run: build
    {{ FUZZER }}

test: build
    #!/bin/bash
    set -eu

    timeout 10s {{ FUZZER }} || true

    STATS_FILE="./workdir/worker_0/fuzzer_stats"
    if [ ! -f "$STATS_FILE" ]; then
        echo "{{ FUZZER_NAME }}: Stats file not found at $STATS_FILE"
        exit 1
    fi

    CORPUS=$(jq '.corpus' "$STATS_FILE")
    if [ "$CORPUS" -ge 2 ]; then
        echo "{{ FUZZER_NAME }}: Grammar inputs reached $CORPUS corpus entries."
    else
        echo "{{ FUZZER_NAME }}: Fuzzer did not evolve the grammar corpus (found $CORPUS entries in $STATS_FILE)"
        exit 1
    fi
